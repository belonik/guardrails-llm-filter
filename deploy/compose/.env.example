# Copy to .env before starting the stand:
#
#   cp .env.example .env
#
# Every value here has a working default in docker-compose.yml, so the file is
# only needed when you want to override something. test-fixes.sh reads the
# engine token and the published ports from this file, so keep them in sync if
# you change them.

# Image built by ./build.sh (or `docker build -t guardrails-llm-filter:test .`).
# Point this at the registry path to verify the artefact that will be deployed:
#   GUARDRAILS_IMAGE=hub.edna.ru/genai/guardrails-llm-filter:<tag>
GUARDRAILS_IMAGE=guardrails-llm-filter:test

# Bearer token for the engine API (both replicas share it). Fake by design —
# this stand is a loopback-only test bench, never a deployment.
GUARDRAILS_ENGINE_API_TOKEN=stand-engine-token

# Postgres: the shared store behind rules, settings, audit, masking state and
# the distributed masking counters (#23).
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=guardrails
POSTGRES_USER=guardrails
POSTGRES_PASSWORD=guardrails

# At-rest encryption for masking state / audit payloads. Off in the stand to
# keep it dependency-free; turn it on to exercise the encrypted store path the
# same way production does:
#   GUARDRAILS_STORE_ENCRYPTION_ENABLED=true
#   GUARDRAILS_STORE_ENCRYPTION_KEY=$(openssl rand -base64 32)
GUARDRAILS_STORE_ENCRYPTION_ENABLED=false
GUARDRAILS_STORE_ENCRYPTION_KEY=

# Fix #23 knob: auto (shared store on postgres/redis) | store | local.
GUARDRAILS_METRICS_SUMMARY_SOURCE=auto

# Fix #22 knob: 0 keeps grpc-go's built-in 4 MiB management-API limit.
GUARDRAILS_GRPC_MAX_MESSAGE_BYTES=100000000

# Fix #20 knob: false runs the service as a component with no gateway listener
# and no upstream requirement at all.
GUARDRAILS_DATA_PLANE_ENABLED=true
GUARDRAILS_UPSTREAM_BASE_URL=http://mock-llm:8890

GUARDRAILS_MODE=enforce
GUARDRAILS_LOG_LEVEL=info

# Published host ports (loopback only). Change only if they clash with
# something already running on your machine.
GW1_PORT=8080
GW2_PORT=8081
API1_PORT=9080
API2_PORT=9081
METRICS1_PORT=9090
METRICS2_PORT=9091
ENGINE1_PORT=9100
ENGINE2_PORT=9101
MOCK_PORT=8890
